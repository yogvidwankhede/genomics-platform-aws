manifest {
    name            = 'yogvidwankhede/genomics-platform-aws'
    description     = 'Germline short-variant calling (BWA-MEM2 + GATK/DeepVariant) with GIAB hap.py validation'
    author          = 'Yogvid Wankhede'
    homePage        = 'https://github.com/yogvidwankhede/genomics-platform-aws'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = '0.2.0' // x-release-please-version
}

plugins {
    id 'nf-schema@2.8.0'
}

params {
    // inputs
    input         = null
    fasta         = null
    fasta_fai     = null
    fasta_dict    = null
    bwamem2_index = null
    intervals     = null

    // calling
    caller        = 'gatk'   // or 'deepvariant', or 'gatk,deepvariant' for both on the same alignments
    filter_expr   = null   // null = caller-specific default, see CALL_VARIANTS
    skip_fastqc   = false
    bwamem2_batch_bases = 100000000   // bwa-mem2 -K; 0 = tool default (thread-dependent)

    // benchmarking
    truth_vcf      = null
    truth_bed      = null
    stratification = null   // directory with strata.tsv + BEDs (GIAB genome stratifications)

    // output / infra
    outdir        = 'results'
    publish_mode  = 'copy'
    aws_region         = 'us-east-1'
    aws_queue          = null
    aws_logs_group     = null
    task_role_arn      = null
    container_registry = null   // e.g. <acct>.dkr.ecr.<region>.amazonaws.com/mirror/
    max_cpus           = 8      // awsbatch per-task ceiling (fit the compute environment)
    max_memory         = '14.GB'
    help          = false
}

validation {
    help {
        enabled = true
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) --platform linux/amd64'
    }
    test {
        includeConfig 'conf/test.config'
    }
    benchmark {
        includeConfig 'conf/benchmark.config'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
}

// Provenance for every run: trace, timeline, HTML report and DAG land next to the results.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    fields  = 'task_id,hash,native_id,process,tag,status,exit,attempt,submit,start,complete,duration,realtime,cpus,%cpu,peak_rss,rss,read_bytes,write_bytes'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
