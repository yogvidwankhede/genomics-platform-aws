// Minimal end-to-end test: 100 kb slice of GIAB HG001 chr20 (~12.7k read pairs), runs in minutes.
params {
    input       = "${projectDir}/tests/data/samplesheet.csv"
    fasta       = "${projectDir}/tests/data/ref.fa"
    intervals   = "${projectDir}/tests/data/intervals.bed"
    truth_vcf   = "${projectDir}/tests/data/truth.vcf.gz"
    truth_bed   = "${projectDir}/tests/data/truth.bed"
}
process {
    resourceLimits = [cpus: 4, memory: 6.GB, time: 1.h]
}
