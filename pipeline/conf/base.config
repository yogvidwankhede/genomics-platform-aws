// Resource classes. resourceLimits caps every request at what the executor can actually provide,
// so the same labels work on a laptop and on AWS Batch.
process {
    cpus   = { 1 * task.attempt }
    memory = { 2.GB * task.attempt }
    time   = { 2.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    resourceLimits = [cpus: 8, memory: 14.GB, time: 24.h]

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 * task.attempt }
        memory = { 12.GB * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 12.GB * task.attempt }
    }
}
