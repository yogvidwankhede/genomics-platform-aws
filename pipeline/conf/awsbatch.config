// AWS Batch execution. The Nextflow head job itself runs on Batch (infra/modules/batch); the
// submit Lambda injects queue, region, role, registry and S3 work/out dirs per run.
//
// Private subnets have no internet route, so:
//   * containers come from the ECR mirror (params.container_registry, scripts/mirror_images.sh)
//   * task containers stage S3 data with the AWS CLI that instances install at boot from the
//     artifacts bucket into /opt/aws-cli (infra/modules/batch user-data)
// A profile-level plugins block replaces the top-level list, so nf-schema is repeated here.
plugins {
    id 'nf-schema@2.8.0'
    id 'nf-amazon@3.12.1'
}
process {
    executor = 'awsbatch'
    queue    = { params.aws_queue }
    // Sized for a new account's 5-vCPU Spot quota: the head job (1 vCPU, 2 GB) plus one
    // 3-vCPU / 12 GB task fit on a single 4-vCPU, 16 GB instance (m6i/m5.xlarge).
    // Raise together with infra max_vcpus once the quota is increased.
    resourceLimits = [cpus: 3, memory: 12.GB, time: 4.h]
}
aws {
    region = params.aws_region
    batch {
        cliPath              = '/opt/aws-cli/bin/aws'
        jobRole              = params.task_role_arn
        logsGroup            = params.aws_logs_group
        maxParallelTransfers = 4
        maxTransferAttempts  = 3
        delayBetweenAttempts = '5 sec'
        maxSpotAttempts      = 3
    }
    client {
        maxConnections    = 8
        storageEncryption = 'aws:kms'
    }
}
docker.enabled = true
