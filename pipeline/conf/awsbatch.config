// AWS Batch execution. The head job runs in Batch too (see infra/modules/batch); work dir and
// results live in S3. Queue/bucket values are injected by the trigger Lambda per environment.
params {
    aws_queue = null
}
process {
    executor = 'awsbatch'
    queue    = params.aws_queue
}
aws {
    region = params.aws_region
    batch {
        cliPath         = '/home/ec2-user/miniconda/bin/aws'
        maxParallelTransfers = 4
        maxTransferAttempts  = 3
        delayBetweenAttempts = '5 sec'
        maxSpotAttempts      = 3
    }
    client {
        maxConnections = 8
        storageEncryption = 'aws:kms'
    }
}
docker.enabled = true
