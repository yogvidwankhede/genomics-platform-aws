// GIAB HG001 benchmark: chr20:10,000,000-12,000,000 at 30x, GIAB NISTv4.2.1 truth.
// Fetch the inputs first with `make benchmark-data` (scripts/fetch_benchmark_data.sh).
params {
    input       = "${projectDir}/../data/benchmark/samplesheet.csv"
    fasta       = "${projectDir}/../data/benchmark/chr20.fa"
    intervals   = "${projectDir}/../data/benchmark/calling_region.bed"
    truth_vcf   = "${projectDir}/../data/benchmark/truth.vcf.gz"
    truth_bed   = "${projectDir}/../data/benchmark/truth.bed"
}
