process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: params.publish_mode,
        saveAs: { filename -> filename == 'versions.yml' ? null : filename },
    ]

    withName: 'BWAMEM2_INDEX|SAMTOOLS_FAIDX|GATK4_CREATESEQUENCEDICTIONARY' {
        publishDir = [path: { "${params.outdir}/reference" }, mode: params.publish_mode]
    }
    withName: 'BWAMEM2_MEM|SEQTK_SAMPLE' {
        publishDir = [enabled: false]
    }
    withName: 'FASTP' {
        ext.args   = '--length_required 50'
        publishDir = [path: { "${params.outdir}/fastp" }, mode: params.publish_mode, pattern: '*.{json,html}']
    }
    withName: 'GATK4_MARKDUPLICATES' {
        publishDir = [path: { "${params.outdir}/alignment" }, mode: params.publish_mode]
    }
    withName: 'GATK4_HAPLOTYPECALLER|DEEPVARIANT|BCFTOOLS_NORM|BCFTOOLS_FILTER' {
        publishDir = [path: { "${params.outdir}/variants/${meta.id}" }, mode: params.publish_mode]
    }
    withName: 'HAPPY' {
        publishDir = [path: { "${params.outdir}/benchmark/${meta.id}" }, mode: params.publish_mode]
    }
    withName: 'SUMMARIZE_RUN' {
        publishDir = [path: { "${params.outdir}/summary" }, mode: params.publish_mode]
    }
    withName: 'MULTIQC' {
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_mode]
    }
}
