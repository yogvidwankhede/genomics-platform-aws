// M7 experiment matrix (local Docker). Usage (see `make research-matrix`):
//   nextflow -c research/conf/research.config run pipeline -profile docker --outdir <dir> -resume
// Pass --outdir on the command line: trace/report paths in nextflow.config are resolved from
// params.outdir *before* a -c file is applied, so an outdir set here would not move them.
params {
    input          = "${projectDir}/../data/research/samplesheet_matrix.csv"
    fasta          = "${projectDir}/../data/research/chr20.fa"
    intervals      = "${projectDir}/../data/research/calling_region.bed"
    stratification = "${projectDir}/../data/research/strata"
    caller         = 'gatk,deepvariant'
    skip_fastqc    = true
}
process {
    resourceLimits = [cpus: 8, memory: 13.GB, time: 4.h]
}
executor {
    cpus   = 8
    memory = 13.GB
}
