// M7 experiment matrix (local Docker). Usage:
//   nextflow run pipeline -profile docker -c research/conf/research.config -resume
params {
    input          = "${projectDir}/../data/research/samplesheet_matrix.csv"
    fasta          = "${projectDir}/../data/research/chr20.fa"
    intervals      = "${projectDir}/../data/research/calling_region.bed"
    stratification = "${projectDir}/../data/research/strata"
    caller         = 'gatk,deepvariant'
    skip_fastqc    = true
    outdir         = "${projectDir}/../data/runs/research-matrix"
}
process {
    resourceLimits = [cpus: 8, memory: 13.GB, time: 4.h]
}
executor {
    cpus   = 8
    memory = 13.GB
}
